{
  "name": "pyk-invoice-system",
  "version": "1.0.0",
  "private": true,
  "description": "PYK Invoice System: static front end plus Express API on PostgreSQL",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "db:init": "node --env-file-if-exists=.env server/scripts/initDb.js",
    "db:seed-regions": "node --env-file-if-exists=.env server/scripts/seedSampleRegions.js",
    "create-staff": "node --env-file-if-exists=.env server/scripts/createStaff.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  }
}
